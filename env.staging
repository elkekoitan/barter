# Firebase Configuration (Staging)
FIREBASE_API_KEY=AIzaSyBxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FIREBASE_APP_ID=1:123456789012:web:abcdefghijklmnop
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_PROJECT_ID=bogazici-barter-app-staging
FIREBASE_STORAGE_BUCKET=bogazici-barter-app-staging.appspot.com
FIREBASE_AUTH_DOMAIN=bogazici-barter-app-staging.firebaseapp.com
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# API Configuration
API_BASE_URL=https://staging-api.bogazicibarter.com/v1
API_TIMEOUT=30000
API_VERSION=v1

# Payment Configuration (Test/Development)
PAYMENT_PAPARA_API_URL=https://sandbox-api.papara.com
PAYMENT_PAPARA_API_KEY=your_staging_papara_api_key
PAYMENT_PAPARA_SECRET=your_staging_papara_secret

PAYMENT_IYZICO_API_URL=https://sandbox-api.iyzico.com
PAYMENT_IYZICO_API_KEY=your_staging_iyzico_api_key
PAYMENT_IYZICO_SECRET=your_staging_iyzico_secret

PAYMENT_TOSLA_API_URL=https://sandbox-api.tosla.com
PAYMENT_TOSLA_API_KEY=your_staging_tosla_api_key
PAYMENT_TOSLA_SECRET=your_staging_tosla_secret

# Google Maps Configuration
GOOGLE_MAPS_API_KEY=AIzaSyCxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Social Login Configuration (Development)
GOOGLE_CLIENT_ID=your_staging_google_client_id
GOOGLE_CLIENT_SECRET=your_staging_google_client_secret

FACEBOOK_APP_ID=your_staging_facebook_app_id
FACEBOOK_APP_SECRET=your_staging_facebook_app_secret

APPLE_CLIENT_ID=your_staging_apple_client_id
APPLE_TEAM_ID=your_staging_apple_team_id
APPLE_KEY_ID=your_staging_apple_key_id
APPLE_PRIVATE_KEY=your_staging_apple_private_key

# Security Configuration
JWT_SECRET=your_staging_jwt_secret
ENCRYPTION_KEY=your_staging_encryption_key

# App Configuration
APP_NAME=Bogazici Barter (Staging)
APP_VERSION=1.0.0
APP_BUILD=1
APP_ENVIRONMENT=staging

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CRASHLYTICS=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_MULTILINGUAL=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_LOCATION_SERVICES=true

# Rate Limiting (More lenient for staging)
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_WINDOW_MINUTES=30
RATE_LIMIT_API_CALLS=2000
RATE_LIMIT_UPLOADS=100

# File Upload Configuration
MAX_FILE_SIZE=10485760
MAX_IMAGE_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp
ALLOWED_DOCUMENT_TYPES=pdf,doc,docx,txt

# Cache Configuration
CACHE_TTL_MINUTES=30
CACHE_MAX_SIZE_MB=50

# Email Configuration (Development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=staging-noreply@bogazicibarter.com
SMTP_PASSWORD=your_staging_smtp_password
SMTP_TLS=true

# SMS Configuration (Test)
SMS_API_URL=https://sandbox-api.smsprovider.com
SMS_API_KEY=your_staging_sms_api_key
SMS_API_SECRET=your_staging_sms_api_secret
SMS_SENDER_ID=BOGAZICI-STG

# Push Notification Configuration
PUSH_NOTIFICATION_SERVER_KEY=your_staging_push_server_key
PUSH_NOTIFICATION_URL=https://fcm.googleapis.com/fcm/send

# Database Configuration
DATABASE_URL=postgresql://username:password@staging-host:port/database
DATABASE_POOL_MIN=3
DATABASE_POOL_MAX=10

# Redis Configuration
REDIS_URL=redis://staging-redis:6379
REDIS_PASSWORD=your_staging_redis_password
REDIS_DB=0

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FILE_PATH=/var/log/bogazici-barter/staging.log
LOG_MAX_SIZE=50MB
LOG_MAX_FILES=15

# Monitoring Configuration
MONITORING_ENABLED=true
MONITORING_API_URL=https://staging-monitoring.example.com
MONITORING_API_KEY=your_staging_monitoring_api_key

# CDN Configuration
CDN_URL=https://staging-cdn.bogazicibarter.com
CDN_ENABLED=true

# SSL Configuration
SSL_CERT_PATH=/etc/ssl/certs/bogazici-barter-staging.crt
SSL_KEY_PATH=/etc/ssl/private/bogazici-barter-staging.key
SSL_ENABLED=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_FREQUENCY=weekly
BACKUP_RETENTION_DAYS=14
BACKUP_STORAGE_PATH=/var/backups/bogazici-barter-staging

# Maintenance Configuration
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Staging system is under maintenance. Please try again later.
MAINTENANCE_ALLOWED_IPS=127.0.0.1,::1,192.168.1.0/24

# Admin Configuration
ADMIN_EMAIL=staging-admin@bogazicibarter.com
ADMIN_PHONE=+905xxxxxxxxx

# Business Configuration
BUSINESS_NAME=Bogazici Barter (Staging)
BUSINESS_ADDRESS=Bogazici University, Istanbul, Turkey
BUSINESS_PHONE=+90212xxxxxxx
BUSINESS_EMAIL=staging-info@bogazicibarter.com
BUSINESS_WEBSITE=https://staging.bogazicibarter.com

# Legal Configuration
TERMS_URL=https://staging.bogazicibarter.com/terms
PRIVACY_URL=https://staging.bogazicibarter.com/privacy
SUPPORT_URL=https://staging.bogazicibarter.com/support

# Commission Configuration
COMMISSION_PERCENTAGE=1.5
MINIMUM_COMMISSION=0.5
MAXIMUM_COMMISSION=25.0

# Currency Configuration
DEFAULT_CURRENCY=TRY
SUPPORTED_CURRENCIES=TRY,USD,EUR,GBP
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/

# Location Configuration
DEFAULT_COUNTRY=TR
DEFAULT_CITY=Istanbul
DEFAULT_TIMEZONE=Europe/Istanbul
DEFAULT_LANGUAGE=tr

# AI Configuration
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=your_staging_ai_api_key
AI_MODEL=gpt-3.5-turbo
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# Notification Configuration
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SMS_ENABLED=true
NOTIFICATION_PUSH_ENABLED=true
NOTIFICATION_WEBHOOK_URL=https://staging-hooks.bogazicibarter.com/notifications
