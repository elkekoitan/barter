# Firebase Configuration
FIREBASE_API_KEY=AIzaSyBxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FIREBASE_APP_ID=1:123456789012:web:abcdefghijklmnop
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_PROJECT_ID=bogazici-barter-app
FIREBASE_STORAGE_BUCKET=bogazici-barter-app.appspot.com
FIREBASE_AUTH_DOMAIN=bogazici-barter-app.firebaseapp.com
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# API Configuration
API_BASE_URL=https://api.bogazicibarter.com/v1
API_TIMEOUT=30000
API_VERSION=v1

# Payment Configuration
PAYMENT_PAPARA_API_URL=https://api.papara.com
PAYMENT_PAPARA_API_KEY=your_production_papara_api_key
PAYMENT_PAPARA_SECRET=your_production_papara_secret

PAYMENT_IYZICO_API_URL=https://api.iyzico.com
PAYMENT_IYZICO_API_KEY=your_production_iyzico_api_key
PAYMENT_IYZICO_SECRET=your_production_iyzico_secret

PAYMENT_TOSLA_API_URL=https://api.tosla.com
PAYMENT_TOSLA_API_KEY=your_production_tosla_api_key
PAYMENT_TOSLA_SECRET=your_production_tosla_secret

# Google Maps Configuration
GOOGLE_MAPS_API_KEY=AIzaSyCxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Social Login Configuration
GOOGLE_CLIENT_ID=your_production_google_client_id
GOOGLE_CLIENT_SECRET=your_production_google_client_secret

FACEBOOK_APP_ID=your_production_facebook_app_id
FACEBOOK_APP_SECRET=your_production_facebook_app_secret

APPLE_CLIENT_ID=your_production_apple_client_id
APPLE_TEAM_ID=your_production_apple_team_id
APPLE_KEY_ID=your_production_apple_key_id
APPLE_PRIVATE_KEY=your_production_apple_private_key

# Security Configuration
JWT_SECRET=your_production_jwt_secret
ENCRYPTION_KEY=your_production_encryption_key

# App Configuration
APP_NAME=Bogazici Barter
APP_VERSION=1.0.0
APP_BUILD=1
APP_ENVIRONMENT=production

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CRASHLYTICS=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_MULTILINGUAL=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_LOCATION_SERVICES=true

# Rate Limiting
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_API_CALLS=1000
RATE_LIMIT_UPLOADS=50

# File Upload Configuration
MAX_FILE_SIZE=10485760
MAX_IMAGE_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp
ALLOWED_DOCUMENT_TYPES=pdf,doc,docx,txt

# Cache Configuration
CACHE_TTL_MINUTES=60
CACHE_MAX_SIZE_MB=100

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@bogazicibarter.com
SMTP_PASSWORD=your_production_smtp_password
SMTP_TLS=true

# SMS Configuration
SMS_API_URL=https://api.smsprovider.com
SMS_API_KEY=your_production_sms_api_key
SMS_API_SECRET=your_production_sms_api_secret
SMS_SENDER_ID=BOGAZICI

# Push Notification Configuration
PUSH_NOTIFICATION_SERVER_KEY=your_production_push_server_key
PUSH_NOTIFICATION_URL=https://fcm.googleapis.com/fcm/send

# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_production_redis_password
REDIS_DB=0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=/var/log/bogazici-barter/app.log
LOG_MAX_SIZE=100MB
LOG_MAX_FILES=30

# Monitoring Configuration
MONITORING_ENABLED=true
MONITORING_API_URL=https://monitoring.example.com
MONITORING_API_KEY=your_production_monitoring_api_key

# CDN Configuration
CDN_URL=https://cdn.bogazicibarter.com
CDN_ENABLED=true

# SSL Configuration
SSL_CERT_PATH=/etc/ssl/certs/bogazici-barter.crt
SSL_KEY_PATH=/etc/ssl/private/bogazici-barter.key
SSL_ENABLED=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/var/backups/bogazici-barter

# Maintenance Configuration
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System is under maintenance. Please try again later.
MAINTENANCE_ALLOWED_IPS=127.0.0.1,::1

# Admin Configuration
ADMIN_EMAIL=admin@bogazicibarter.com
ADMIN_PHONE=+905xxxxxxxxx

# Business Configuration
BUSINESS_NAME=Bogazici Barter
BUSINESS_ADDRESS=Bogazici University, Istanbul, Turkey
BUSINESS_PHONE=+90212xxxxxxx
BUSINESS_EMAIL=info@bogazicibarter.com
BUSINESS_WEBSITE=https://bogazicibarter.com

# Legal Configuration
TERMS_URL=https://bogazicibarter.com/terms
PRIVACY_URL=https://bogazicibarter.com/privacy
SUPPORT_URL=https://bogazicibarter.com/support

# Commission Configuration
COMMISSION_PERCENTAGE=2.5
MINIMUM_COMMISSION=1.0
MAXIMUM_COMMISSION=50.0

# Currency Configuration
DEFAULT_CURRENCY=TRY
SUPPORTED_CURRENCIES=TRY,USD,EUR,GBP
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/

# Location Configuration
DEFAULT_COUNTRY=TR
DEFAULT_CITY=Istanbul
DEFAULT_TIMEZONE=Europe/Istanbul
DEFAULT_LANGUAGE=tr

# AI Configuration
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=your_production_ai_api_key
AI_MODEL=gpt-3.5-turbo
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# Notification Configuration
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SMS_ENABLED=true
NOTIFICATION_PUSH_ENABLED=true
NOTIFICATION_WEBHOOK_URL=https://hooks.bogazicibarter.com/notifications
