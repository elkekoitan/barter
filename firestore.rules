rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 🔥 FIREBASE SECURITY RULES - BACKEND LOGIC 🔥
    // Helper functions - These run on Firebase servers
    function isAuthenticated() {
      return request.auth != null; // ✅ User is logged in
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId; // ✅ Owner check
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true; // ✅ Admin check
    }

    // 🔥 REAL-TIME VALIDATION - Happens on every database operation 🔥

    // Users collection
    match /users/{userId} {
      // Users can read and write their own profile
      allow read, write: if isOwner(userId);

      // Allow read for listing details and chat participants
      allow read: if isAuthenticated();

      // Users can create their own profile
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // Admin can read all users
      allow read: if isAdmin();
    }

    // Listings collection
    match /listings/{listingId} {
      // Anyone can read active listings
      allow read: if resource.data.status == 'active';

      // Users can read their own listings
      allow read: if isOwner(resource.data.userId);

      // Authenticated users can create listings
      allow create: if isAuthenticated() &&
        request.auth.uid == resource.data.userId;

      // Users can update their own listings
      allow update: if isOwner(resource.data.userId) &&
        request.auth.uid == resource.data.userId;

      // Users can delete their own listings
      allow delete: if isOwner(resource.data.userId);

      // Admin can manage all listings
      allow read, write: if isAdmin();
    }

    // Barter offers collection
    match /barter_offers/{offerId} {
      // Participants can read offers
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.receiverId
      );

      // Users can create offers for their own listings
      allow create: if isAuthenticated() &&
        request.auth.uid == resource.data.senderId;

      // Only sender can update their offers
      allow update: if isAuthenticated() &&
        request.auth.uid == resource.data.senderId;

      // Admin can manage all offers
      allow read, write: if isAdmin();
    }

    // Barter transactions collection
    match /barter_transactions/{transactionId} {
      // Participants can read transactions
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.receiverId
      );

      // Users can create transactions for accepted offers
      allow create: if isAuthenticated() &&
        (request.auth.uid == resource.data.senderId ||
         request.auth.uid == resource.data.receiverId);

      // Participants can update transaction status
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.receiverId
      );

      // Admin can manage all transactions
      allow read, write: if isAdmin();
    }

    // Reviews collection
    match /reviews/{reviewId} {
      // Anyone can read reviews
      allow read;

      // Users can create reviews for completed transactions
      allow create: if isAuthenticated();

      // Users can update their own reviews
      allow update: if isAuthenticated() &&
        request.auth.uid == resource.data.userId;

      // Admin can manage all reviews
      allow write: if isAdmin();
    }

    // Chat messages collection
    match /chat_messages/{messageId} {
      // Chat participants can read messages
      allow read: if isAuthenticated() &&
        exists(/databases/$(database)/documents/chat_rooms/$(resource.data.roomId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(resource.data.roomId)).data.participants;

      // Users can create messages in their chat rooms
      allow create: if isAuthenticated() &&
        exists(/databases/$(database)/documents/chat_rooms/$(resource.data.roomId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(resource.data.roomId)).data.participants;

      // Admin can read all messages
      allow read: if isAdmin();
    }

    // Chat rooms collection
    match /chat_rooms/{roomId} {
      // Chat participants can read room info
      allow read: if isAuthenticated() &&
        request.auth.uid in resource.data.participants;

      // Users can create chat rooms
      allow create: if isAuthenticated() &&
        request.auth.uid in resource.data.participants;

      // Admin can read all chat rooms
      allow read: if isAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() &&
        request.auth.uid == resource.data.userId;

      // Users can update their own notifications
      allow update: if isAuthenticated() &&
        request.auth.uid == resource.data.userId;

      // System can create notifications
      allow create: if isAdmin() ||
        request.auth == null; // Allow server-side creation

      // Admin can manage all notifications
      allow write: if isAdmin();
    }

    // Categories collection (read-only for all authenticated users)
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Admin settings collection
    match /admin_settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // Security alerts collection
    match /security_alerts/{alertId} {
      // Users can read their own security alerts
      allow read: if isAuthenticated() &&
        request.auth.uid == resource.data.userId;

      // System can create security alerts
      allow create: if isAdmin() ||
        request.auth == null;

      // Users can update their own alerts
      allow update: if isAuthenticated() &&
        request.auth.uid == resource.data.userId;

      // Admin can manage all security alerts
      allow write: if isAdmin();
    }

    // Audit logs collection (admin only)
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // User preferences collection
    match /user_preferences/{userId} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }

    // Location data collection
    match /location_data/{locationId} {
      // Users can read public location data
      allow read: if isAuthenticated();

      // Users can create their own location data
      allow create: if isAuthenticated();

      // Users can update their own location data
      allow update: if isAuthenticated() &&
        request.auth.uid == resource.data.userId;

      // Admin can manage all location data
      allow write: if isAdmin();
    }

    // Help articles collection
    match /help_articles/{articleId} {
      allow read: if isAuthenticated(); // Public read access
      allow write: if isAdmin();
    }

    // Help categories collection
    match /help_categories/{categoryId} {
      allow read: if isAuthenticated(); // Public read access
      allow write: if isAdmin();
    }

    // FAQ collection
    match /faq/{faqId} {
      allow read: if isAuthenticated(); // Public read access
      allow write: if isAdmin();
    }

    // User bookmarks collection
    match /user_bookmarks/{userId} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }

    // Default deny rule
    match /{document=**} {
      allow read, write: if false;
    }
  }
}