rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function hasValidImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    function hasValidFileSize() {
      return request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }

    function isValidDocumentType() {
      return request.resource.contentType.matches('application/pdf') ||
             request.resource.contentType.matches('image/.*') ||
             request.resource.contentType.matches('text/.*');
    }

    function hasValidDocumentSize() {
      return request.resource.size < 25 * 1024 * 1024; // 25MB limit for documents
    }

    // Profile images - users can upload their own profile images
    match /users/{userId}/profile/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) &&
        hasValidImageType() &&
        hasValidFileSize();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Listing images - users can upload images for their listings
    match /listings/{listingId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
        hasValidImageType() &&
        hasValidFileSize() &&
        (isOwner(listingId.split('/')[0]) || isAdmin());
      allow delete: if isAuthenticated() &&
        (isOwner(listingId.split('/')[0]) || isAdmin());
    }

    // Chat attachments - users can upload files in their chats
    match /chat_attachments/{roomId}/{allPaths=**} {
      allow read, write: if isAuthenticated() &&
        hasValidFileSize() &&
        isValidDocumentType();
      allow delete: if isAdmin();
    }

    // Document uploads - KYC documents, verification files
    match /documents/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAuthenticated() &&
        hasValidDocumentSize() &&
        isValidDocumentType();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Admin uploads - system files, banners, etc.
    match /admin/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write, delete: if isAdmin();
    }

    // Public assets - app icons, logos, etc.
    match /public/{allPaths=**} {
      allow read: if true; // Public read access
      allow write: if isAdmin();
    }

    // Temporary uploads - for processing before moving to final location
    match /temp/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId) &&
        hasValidFileSize();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Default deny rule - no access unless explicitly allowed above
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
